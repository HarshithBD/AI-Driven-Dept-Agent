# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to backend/.env and populate your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, and Storage)
# ------------------------------------------------------------------------------
# Supabase Project REST URL
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (REQUIRED by backend for admin/storage/role queries)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role secret
# WARNING: Keep this secret; never expose it on the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Direct PostgreSQL Connection String (Optional / for migrations)
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. AI & Large Language Model (Google Gemini via LangChain)
# ------------------------------------------------------------------------------
# Google AI Studio Gemini API Key (REQUIRED for AIDA Supervisor, Agents & Response Writer)
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key

# Primary Gemini Model identifier
LLM_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 3. Optional / Fallback LLM Providers (OpenRouter / OpenAI-Compatible)
# ------------------------------------------------------------------------------
# Only needed if using alternative OpenRouter routing
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your_openrouter_api_key
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Optional HuggingFace Access Token
# Obtain from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_access_token

# ------------------------------------------------------------------------------
# 4. Vector Database (Qdrant & Local Hybrid RAG)
# ------------------------------------------------------------------------------
# Note: The system runs local FastEmbed + BM25 sparse search and FlashRank reranking
# out of the box. If a Qdrant instance is running, it will automatically connect.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=campus_assistant

# ------------------------------------------------------------------------------
# 5. LangSmith Observability & Agent Tracing (Optional)
# ------------------------------------------------------------------------------
# Enable deep multi-agent trajectory visualization and latency tracking in LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=AIDA-Campus-Assistant

# ------------------------------------------------------------------------------
# 6. CORS / Frontend URL
# ------------------------------------------------------------------------------
# The FastAPI backend restricts CORS to this origin.
# In production, set this to your deployed frontend URL (no trailing slash).
# Multiple origins can be comma-separated: https://app.example.com,https://www.example.com
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Department Customization Configuration (Optional — has sensible defaults)
# ------------------------------------------------------------------------------
# Short department code (e.g. AIML, CSE, ECE, MECH, CIVIL)
DEPARTMENT_CODE=AIML

# Full department display name
DEPARTMENT_NAME=Artificial Intelligence & Machine Learning

# Department acronym
DEPARTMENT_ACRONYM=AIML

# Host academic institution name
INSTITUTION_NAME=Department of AIML

# Comma-separated student section identifiers for timetable and announcements
STUDENT_SECTIONS=AIML-A,AIML-B

