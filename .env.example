# ==============================================================================
# AIDA – AI-Driven Department Agent: Master Environment Variables Reference
# ==============================================================================
# The application consists of two sub-environments:
# 1. Backend (FastAPI, LangGraph Agents, RAG): configured in backend/.env
# 2. Frontend (Next.js, React, Tailwind): configured in frontend/.env.local
# ==============================================================================

# ==============================================================================
# 1. BACKEND CONFIGURATION (backend/.env)
# ==============================================================================

# --- Supabase Database & Auth ---
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional direct postgres URI:
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Google Gemini AI (LangChain / LangGraph) ---
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-3.8-flash

# --- Vector Database & RAG Search ---
# Local FastEmbed (BAAI/bge-small-en-v1.5) and BM25 run locally with zero config.
# If Qdrant is running, it connects here:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=campus_assistant

# --- LangSmith Observability & Agent Tracing (Optional) ---
# Obtain from: https://smith.langchain.com -> Settings -> API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=AIDA-Campus-Assistant

# --- Department Configuration (Optional — defaults to AIML) ---
DEPARTMENT_CODE=AIML
DEPARTMENT_NAME=Artificial Intelligence & Machine Learning
DEPARTMENT_ACRONYM=AIML
INSTITUTION_NAME=Department of AIML
STUDENT_SECTIONS=AIML-A,AIML-B

# --- Optional Alternative LLM & Inference ---
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-v1-your_openrouter_api_key
OPENAI_API_BASE=https://openrouter.ai/api/v1
HUGGINGFACE_API_KEY=hf_your_huggingface_access_token

# ==============================================================================
# 2. FRONTEND CONFIGURATION (frontend/.env.local)
# ==============================================================================
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Obtain from: Supabase Dashboard -> Project Settings -> API -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API server URL (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
